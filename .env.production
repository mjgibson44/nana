# TURN relay for production builds: the Metered free tier (app:
# mattwordgame). Committed on purpose — these values ship verbatim in the
# JS bundle anyway, so the repo hides nothing the site doesn't; the
# free-tier quota (20 GB/month, no overages) is all they gate. Rotate them
# from the Metered dashboard and update here if the quota is ever abused.
#
# The client ADDS this relay to PeerJS's default servers (see iceConfig in
# src/net/battleSession.ts), so a spent quota or dead credential degrades
# to the free shared relay instead of breaking joins.
VITE_TURN_URL=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=3496a1204cde14e2ef5b320f
VITE_TURN_CREDENTIAL=T/us4dFj8YHz78bY
