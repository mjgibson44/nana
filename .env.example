# Multiplayer endpoints, read at build time. All optional: unset, the game
# uses PeerJS's free public broker and relay, which are fine for casual play
# but flaky under pressure. See infra/README.md for running your own —
# these values point the client at that stack.
#
# Locally: copy to .env.local (gitignored) and `npm run build`.
# On a hosting platform: set the same variables in the site's build settings.

# The broker (signaling): where join codes find hosts.
VITE_PEER_HOST=mp.example.com
# Defaults: port 443, path /, secure. Only set these if yours differ.
#VITE_PEER_PORT=443
#VITE_PEER_PATH=/
#VITE_PEER_SECURE=true

# The TURN relay: the fallback path when a player's network refuses direct
# browser-to-browser connections. Comma-separated turn:/turns: URLs.
VITE_TURN_URL=turn:mp.example.com:3478?transport=udp,turn:mp.example.com:3478?transport=tcp
VITE_TURN_USERNAME=nana
VITE_TURN_CREDENTIAL=the-TURN_PASSWORD-from-infra/.env
