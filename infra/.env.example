# Copy to .env (next to docker-compose.yml) and fill in. The .env file stays
# on the server — it's gitignored.

# The one hostname this stack lives behind. An A record for it must point at
# this machine's public IP before the stack first starts (Caddy needs it to
# get the HTTPS certificate).
MP_HOST=mp.example.com

# Where Let's Encrypt sends certificate-expiry mail (it never spams).
ACME_EMAIL=you@example.com

# TURN credentials. These same values go into the game's build as
# VITE_TURN_USERNAME / VITE_TURN_CREDENTIAL — and anything in the build is
# public, so treat them as a throttle, not a secret: the quotas and bandwidth
# cap in docker-compose.yml are what actually keep freeloaders from running
# up the bill. Use a long random password anyway.
TURN_USERNAME=nana
TURN_PASSWORD=change-me-to-something-long-and-random
